{
  "$schema" : "https:\/\/schema.linearmouse.app\/0.12.0",
  "schemes" : [
    {
      "buttons" : {
        "mappings" : [
          {
            "outcomes" : {
              "shortPress" : "missionControl.spaceRight"
            },
            "trigger" : {
              "input" : {
                "button" : 3
              }
            }
          },
          {
            "outcomes" : {
              "shortPress" : "missionControl.spaceLeft"
            },
            "trigger" : {
              "input" : {
                "button" : 4
              }
            }
          }
        ]
      },
      "if" : {
        "device" : {
          "category" : "mouse",
          "productID" : "0xfc61",
          "productName" : "USB Gaming Mouse",
          "vendorID" : "0x4d9"
        }
      },
      "scrolling" : {
        "acceleration" : {
          "vertical" : 1
        },
        "modifiers" : {
          "vertical" : {
            "control" : {
              "type" : "zoom"
            }
          }
        },
        "reverse" : {
          "vertical" : true
        }
      }
    },
    {
      "if" : {
        "device" : {
          "category" : "mouse",
          "productID" : "0x301a",
          "productName" : "Dell MS116 USB Optical Mouse",
          "vendorID" : "0x413c"
        }
      },
      "scrolling" : {
        "reverse" : {
          "vertical" : true
        }
      }
    },
    {
      "buttons" : {
        "clickDebouncing" : {
          "buttons" : [
            0
          ],
          "timeout" : 0
        },
        "gesture" : {
          "actions" : {
            "down" : "appExpose",
            "left" : "missionControl.spaceLeft",
            "right" : "missionControl.spaceRight",
            "up" : "missionControl"
          },
          "enabled" : false,
          "threshold" : 50,
          "trigger" : {
            "button" : 2
          }
        },
        "mappings" : [
          {
            "outcomes" : {
              "shortPress" : "missionControl.spaceRight"
            },
            "trigger" : {
              "input" : {
                "button" : 3
              }
            }
          },
          {
            "outcomes" : {
              "shortPress" : "missionControl.spaceLeft"
            },
            "trigger" : {
              "input" : {
                "button" : 4
              }
            }
          }
        ],
        "switchPrimaryButtonAndSecondaryButtons" : false,
        "universalBackForward" : false
      },
      "if" : {
        "device" : {
          "category" : "mouse",
          "productID" : "0x8a0",
          "vendorID" : "0x1bcf"
        }
      },
      "pointer" : {
        "acceleration" : 8,
        "disableAcceleration" : false,
        "redirectsToScroll" : false,
        "speed" : "unset"
      },
      "scrolling" : {
        "reverse" : {
          "vertical" : true
        }
      }
    }
  ]
}